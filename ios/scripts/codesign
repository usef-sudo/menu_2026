#!/bin/bash
# Flutter/Xcode invoke `codesign` via PATH. Strip iCloud/Desktop File Provider
# xattrs immediately before signing so codesign doesn't fail with
# "resource fork, Finder information, or similar detritus not allowed".
set -euo pipefail

strip_args() {
  for arg in "$@"; do
    if [ -e "$arg" ]; then
      xattr -cr "$arg" 2>/dev/null || true
      xattr -cr "$(dirname "$arg")" 2>/dev/null || true
    fi
  done
}

attempt=1
while [ "${attempt}" -le 3 ]; do
  strip_args "$@"
  if /usr/bin/codesign "$@"; then
    exit 0
  fi
  attempt=$((attempt + 1))
done
exit 1
